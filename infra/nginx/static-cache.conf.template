# Include inside the production site server block serving the built frontend bundle.
gzip on;
gzip_vary on;
gzip_min_length 1024;
gzip_types text/plain text/css application/javascript application/json image/svg+xml;

# Content-hashed Vite bundles (JS, CSS, WebP, WOFF2 subset fonts) are immutable for 1 year.
location ^~ /assets/ {
    expires 1y;
    add_header Cache-Control "public, max-age=31536000, immutable";
    access_log off;
}

# HTML entry points must always revalidate to reference the latest hashed asset manifest.
location = /index.html {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
}
