# 复制为 deploy/.env 并填写；切勿提交 .env
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_APP_ID=<沙箱 APPID>
ALIPAY_PRIVATE_KEY=<应用私钥 PKCS8 单行>
ALIPAY_PUBLIC_KEY=<支付宝公钥 单行>
# 异步通知（已备案域名 HTTPS；punycode 等价：https://pay.xn--ckst2fk89agjv.cn/api/alipay/notify）
ALIPAY_NOTIFY_URL=https://pay.研途学堂.cn/api/alipay/notify
# 至少 32 位随机串，与主后端 PAYMENT_REMOTE_TOKEN 相同：openssl rand -hex 32
PAY_INTERNAL_TOKEN=<random-hex>
PAY_ORDER_TTL_MINUTES=15
